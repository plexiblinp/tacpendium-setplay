{
  "name": "tacpendium-setplay-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10.34.7"
  },
  "scripts": {
    "assets": "bash scripts/prepare-assets.sh",
    "gen:locales": "node scripts/gen-zh-hant.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist-limits.mjs dist && node scripts/build-edge.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "i18next": "^26.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "opencc-js": "^1.4.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
